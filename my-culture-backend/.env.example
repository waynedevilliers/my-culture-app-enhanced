PORT=3000
NODE_ENV=development
DB='postgresql://myDb_owner:password@host/myDb?sslmode=require&channel_binding=require'
SECRET="your-secret-key"

# Email Configuration
EMAIL_PORT=587
EMAIL_HOST=mail.example.com
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-password
EMAIL_FROM=your-email@example.com

# Application URL
URL=http://localhost:3000

# Vercel Blob Storage (Production only)
# Get your token from: https://vercel.com/dashboard/stores
BLOB_READ_WRITE_TOKEN=your-vercel-blob-token

# Legacy Cloudinary (deprecated, not used anymore)
CLOUDNAME="your-cloudinary-name"
CLOUDAPIKEY=your-cloudinary-key
CLOUDAPISECRET="your-cloudinary-secret"
