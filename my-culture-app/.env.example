# Copy to .env.local and fill in. Never commit real values.

# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/myculture"

# Signing key for login tokens, at least 32 characters.
# Generate one with: openssl rand -base64 48
JWT_SECRET=""

# Only for `npm run prisma:seed`: the super admin created on first seed.
# At least 12 characters. The seed never prints it.
SEED_ADMIN_EMAIL="admin@myculture.app"
SEED_ADMIN_PASSWORD=""

# Vercel Blob, for image uploads in production. Without it, uploads go to
# public/uploads (development only).
BLOB_READ_WRITE_TOKEN=""

# Public address of the site, used in links in emails.
APP_URL="http://localhost:3000"

# SMTP for emails (approval, rejection, admin set-password link).
# Without EMAIL_HOST and EMAIL_FROM nothing is sent.
EMAIL_HOST=""
EMAIL_PORT="587"
EMAIL_SECURE="false"
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_FROM=""
