// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MODERATOR
  USER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  CANCELLED
}

// User model
model User {
  id        Int     @id @default(autoincrement())
  email     String  @unique
  firstName String
  lastName  String
  password  String
  role      Role    @default(USER)
  phone     String?
  newsletter Boolean @default(false)
  verified  Boolean @default(false)

  passwordTokens PasswordToken[]

  // The organisation an ADMIN manages. Super admins have none and manage
  // every organisation (including those without an admin of their own).
  organizationId Int?
  organization   Organization? @relation("OrganizationAdmins", fields: [organizationId], references: [id], onDelete: SetNull)
  
  // Relations
  organizations Organization[] @relation("OrganizationOwner")
  events        Event[]
  certificates  Certificate[]
  blogs         Blog[]
  galleries     Gallery[]
  images        Image[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Organization model
model Organization {
  id              Int     @id @default(autoincrement())
  name            String
  email           String? @unique
  description     String?
  website         String?
  phone           String?

  // Postal address. Only super admins change it (legal reasons).
  street          String?
  postalCode      String?
  city            String?

  published       Boolean @default(false)
  verified        Boolean @default(false)

  // "pending" (application from Join us), "approved" or "rejected".
  // Organisations created by an admin are approved directly.
  approvalStatus  String  @default("pending")
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionNotes  String?

  // Application details from the Join us form.
  contactPerson   String?
  adminName       String?
  adminEmail      String?
  applicationDetails Json?

  logoId          String?
  logo            Image?  @relation("OrganizationLogo", fields: [logoId], references: [id], onDelete: SetNull)

  userId          Int?
  user            User?   @relation("OrganizationOwner", fields: [userId], references: [id], onDelete: SetNull)

  // Admins of this organisation (role ADMIN).
  admins          User[]  @relation("OrganizationAdmins")
  
  // Relations
  events          Event[]
  certificates    Certificate[]
  galleries       Gallery[]
  images          Image[] @relation("OrganizationImages")
  locations       Location[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, approvalStatus])
}

// Event model
model Event {
  id              Int     @id @default(autoincrement())
  title           String
  description     String?
  content         String?
  date            DateTime
  startDate       DateTime?
  endDate         DateTime?
  locationString  String?
  capacity        Int?
  status          EventStatus @default(DRAFT)
  published       Boolean @default(false)
  price           Decimal?
  discountedPrice Decimal?
  abendkassePrice Decimal?
  
  userId          Int
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  organizationId  Int?
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  
  locationId      Int?
  location        Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  
  // Relations
  categories      EventCategory[]
  images          Image[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Category model
model Category {
  id    Int     @id @default(autoincrement())
  name  String  @unique
  slug  String  @unique
  
  // Relations
  events EventCategory[]
  blogs  Blog[]
  
  createdAt DateTime @default(now())
}

// EventCategory model
model EventCategory {
  id        Int @id @default(autoincrement())
  eventId   Int
  categoryId Int
  
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category  Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  @@unique([eventId, categoryId])
}

// Location model
model Location {
  id              Int     @id @default(autoincrement())
  name            String
  address         String?
  city            String?
  postalCode      String?
  country         String?
  latitude        Decimal?
  longitude       Decimal?
  
  organizationId  Int?
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  
  // Relations
  events          Event[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Certificate model: one certificate (Christian's design) for one or more
// recipients. Texts and choices are stored as fields, never as HTML.
model Certificate {
  id              String  @id @default(cuid())
  language        String  @default("de") // de | en
  color           String  @default("green") // green | blue | burgundy | grey
  introText       String
  achievement     String
  addition        String?
  // [{ name, role }], 1 to 3 entries
  signatures      Json
  issuedDate      DateTime

  createdById     Int?
  createdBy       User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  organizationId  Int
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  recipients      CertificateRecipient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

// One recipient of a certificate. `code` is the random, unguessable part of
// the private link (/certificates/<code>). Links do not expire but can be
// revoked.
model CertificateRecipient {
  id              String  @id @default(cuid())
  name            String
  // Optional: without an email the link is passed on by hand.
  email           String?
  code            String  @unique
  sentAt          DateTime?
  revokedAt       DateTime?

  certificateId   String
  certificate     Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([certificateId])
}

// Blog model
model Blog {
  id              Int     @id @default(autoincrement())
  title           String
  slug            String  @unique
  content         String
  excerpt         String?
  published       Boolean @default(false)
  
  userId          Int
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  categoryId      Int?
  category        Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  
  // Relations
  images          Image[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Gallery model
model Gallery {
  id              Int     @id @default(autoincrement())
  name            String
  description     String?
  published       Boolean @default(false)
  
  userId          Int
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  organizationId  Int?
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  
  // Relations
  images          Image[]
  imageGalleries  ImageGallery[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Image model
model Image {
  id              String  @id @default(cuid())
  publicId        String?
  url             String
  secureUrl       String?
  fileName        String?
  size            Int?
  width           Int?
  height          Int?
  
  userId          Int?
  user            User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  organizationId  Int?
  organization    Organization? @relation("OrganizationImages", fields: [organizationId], references: [id], onDelete: SetNull)

  // Organisations using this image as their logo.
  logoFor         Organization[] @relation("OrganizationLogo")
  
  eventId         Int?
  event           Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  blogId          Int?
  blog            Blog? @relation(fields: [blogId], references: [id], onDelete: Cascade)
  
  galleryId       Int?
  gallery         Gallery? @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  
  // Relations
  imageGalleries  ImageGallery[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ImageGallery model (Junction table)
model ImageGallery {
  id        Int @id @default(autoincrement())
  imageId   String
  galleryId Int
  order     Int @default(0)
  
  image     Image   @relation(fields: [imageId], references: [id], onDelete: Cascade)
  gallery   Gallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  
  @@unique([imageId, galleryId])
}

// Newsletter/Subscriber model
model Subscriber {
  id        Int     @id @default(autoincrement())
  email     String  @unique
  name      String?
  subscribed Boolean @default(true)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Testimonial model
model Testimonial {
  id        Int     @id @default(autoincrement())
  name      String
  email     String?
  message   String
  rating    Int?
  published Boolean @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One-time "set your password" links. Only a SHA-256 hash of the token is
// stored; the link itself is sent to the person once.
model PasswordToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())

  @@index([userId])
}
